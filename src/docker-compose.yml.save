version: '3.8'
services:
  postgres:
    image: pgvector/pgvector:pg16
    container_name: swift_postgres
    environment:
      POSTGRES_DB: swift_support
      POSTGRES_USER: support_user
      POSTGRES_PASSWORD: support_pass
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
volumes:
  pgdata:
